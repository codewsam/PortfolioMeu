                        <span>Ø 6.3 c/ 14 cm</span>
                      </div>
                      <div class="param-box">
                        <label>Cobrimento Nominal</label>
                        <span>c_nom = 30 mm (Classe II)</span>
                      </div>
                      <div class="param-box">
                        <label>Taxa de Aço</label>
                        <span>ρ = 1.18% (Econômico)</span>
                      </div>
                    </div>

                    <div class="cad-cross-section" title="Seção Transversal Paramétrica">
