      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="index.css" />
  </head>
  <body>
    <div class="page-shell">
      <!-- TOPBAR COM GLASSMORPHISM SUTIL -->
      <header class="topbar">
        <a class="brand" href="#home" aria-label="Samuel - Voltar ao topo">
          <span class="brand-mark">S</span>
          <div class="brand-text">
            <span>Samuel</span>
            <span class="brand-tag">Engenharia & Automação</span>
          </div>
        </a>

        <nav class="nav" aria-label="Navegação principal">
          <a href="#sobre">Sobre</a>
          <a href="#competencias">Competências</a>
          <a href="#projetos">Projetos</a>
          <a href="#contato">Contato</a>
        </nav>

        <a class="btn btn-primary" href="#contato">Falar comigo</a>
      </header>

      <main>
        <!-- HERO SECTION -->
        <section id="home" class="hero">
          <div class="hero-copy">
            <div class="status-badge">
              <span class="status-dot"></span>
              Disponível para automações e consultoria estrutural
            </div>

            <h1>
              Engenharia Estrutural, <span class="gradient-text">Automação BIM</span> & Software
            </h1>

            <p class="lead">
              Sou Samuel, formado em Engenharia de Software e atualmente cursando Matemática na
              Universidade Federal de Alagoas (UFAL). Desenvolvo rotinas inteligentes, plugins em Python
              para TQS e Revit, e soluções computacionais que eliminam retrabalho e aumentam o rigor
              técnico em projetos de concreto armado.
            </p>

            <div class="cta-group">
              <a class="btn btn-primary" href="#projetos">
                Ver projetos
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </a>
              <a class="btn btn-secondary" href="#contato">Solicitar contato</a>
            </div>

            <!-- PILARES TÉCNICOS / MÉTRICAS -->
            <ul class="hero-stats" aria-label="Principais áreas de atuação e tecnologias">
              <li class="stat-item">
                <strong>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                  TQS + Python
                </strong>
                <span>Automação e parametrização de formas e armaduras NBR 6118</span>
              </li>

              <li class="stat-item">
                <strong>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                  Revit + BIM
                </strong>
                <span>Modelagem 3D paramétrica de vergalhões e scripts Dynamo</span>
              </li>

              <li class="stat-item">
                <strong>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/></svg>
                  Matemática (UFAL)
                </strong>
                <span>Geometria computacional, algoritmos e matrizes de rigidez</span>
              </li>

              <li class="stat-item">
                <strong>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
                  Web & Dados
                </strong>
                <span>Dashboards de engenharia e ferramentas de produtividade</span>
              </li>
            </ul>
          </div>
        </section>

        <!-- SEÇÃO SOBRE -->
        <section id="sobre" class="info-section">
          <div class="section-heading">
            <p class="eyebrow">Sobre</p>
            <h2>Rigor técnico da engenharia aliado à eficiência e escalabilidade do software.</h2>
          </div>

          <div class="about-grid">
            <article class="about-card">
              <div class="card-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
              </div>
              <h3>Base em Concreto Armado</h3>
              <p>
                Trabalho com cálculo e detalhamento de concreto armado com rigor normativo
                (NBR 6118): controle de cobrimentos, comprimentos de ancoragem, emendas por
                transpasse e nós de pórtico com atenção à realidade executiva no canteiro.
              </p>
            </article>

            <article class="about-card">
              <div class="card-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              </div>
              <h3>Engenharia de Software</h3>
              <p>
                Substituo tarefas manuais e rotinas frágeis por scripts e plugins robustos.
                A automação reduz o retrabalho em até 80%, mitiga falhas humanas e padroniza
                o padrão de entrega técnica do escritório.
              </p>
            </article>

            <article class="about-card">
              <div class="card-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              </div>
              <h3>Formação Matemática (UFAL)</h3>
              <p>
                A graduação em Matemática complementa minha atuação com forte raciocínio lógico,
                geometria analítica e computacional, permitindo resolver desafios geométricos complexos
                em elementos estruturais e fluxos de dados.
              </p>
            </article>
          </div>
