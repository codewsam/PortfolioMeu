                        <span class="rebar-dot"></span>
                        <span class="rebar-dot"></span>
                        <span class="rebar-dot"></span>
                        <span class="rebar-dot"></span>
                      </div>
                    </div>

                    <div class="inspector-footer">
                      <span>Interferências: 0 detectadas</span>
                      <span class="status-ok">✔ Validação NBR Concluída</span>
                    </div>
                  </div>
                </div>
