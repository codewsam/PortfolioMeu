:root {
  --bg: #090611;
  --bg-2: #140d22;
  --panel: rgba(28, 18, 42, 0.9);
  --panel-strong: #1d1132;
  --panel-soft: rgba(116, 72, 181, 0.14);
  --purple-1: #8b5cf6;
  --purple-2: #a855f7;
  --purple-3: #d8b4fe;
  --text: #f8f4ff;
  --muted: #d1c7eb;
  --line: rgba(255, 255, 255, 0.08);
  --shadow: 0 24px 60px rgba(88, 45, 168, 0.35);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(168, 85, 247, 0.18), transparent 25%),
    radial-gradient(circle at bottom right, rgba(92, 118, 246, 0.22), transparent 30%),
    var(--bg);
  color: var(--text);
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

.page-shell {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
  padding: 24px 0 40px;
}

.topbar {
  position: sticky;
  top: 18px;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 0 auto 32px;
  padding: 18px 24px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(12, 8, 22, 0.72);
  backdrop-filter: blur(22px);
  box-shadow: 0 16px 40px rgba(13, 9, 19, 0.35);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.brand-mark {
  display: inline-grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--purple-3), var(--purple-1));
  color: #120b20;
  font-weight: 900;
}

.nav {
  display: flex;
  align-items: center;
  gap: 24px;
  color: var(--muted);
  font-size: 0.96rem;
}

.nav a {
  transition: color 0.2s ease;
}

.nav a:hover,
.nav a:focus-visible {
  color: var(--text);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  border: 1px solid transparent;
  padding: 0.9rem 1.5rem;
  font-weight: 600;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.btn:hover,
.btn:focus-visible {
  transform: translateY(-2px);
}

.btn-primary {
  background: linear-gradient(135deg, var(--purple-1), var(--purple-2));
  color: #ffffff;
  box-shadow: 0 18px 32px rgba(138, 92, 246, 0.45);
}

.btn-secondary {
  border-color: var(--line);
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
}

.hero {
  display: grid;
  grid-template-columns: 1fr;
  align-items: center;
  justify-items: center;
  gap: 24px;
  padding: 52px 0 30px;
  text-align: center;
}

.eyebrow {
  margin: 0 0 16px;
  color: var(--purple-3);
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 700;
}

.hero-copy {
  max-width: 860px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
}

.lead {
  max-width: 62ch;
  margin: 20px 0 0;
  color: var(--muted);
  font-size: 1.1rem;
  line-height: 1.7;
  text-align: center;
}

.cta-group {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16px;
  margin-top: 28px;
}

.hero-stats {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, minmax(110px, 1fr));
  gap: 16px;
  padding: 0;
  margin: 34px auto 0;
  width: min(100%, 700px);
}

.hero-stats li {
  padding: 18px 14px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.015);
}

.hero-stats strong {
  display: block;
  font-size: 1.5rem;
  margin-bottom: 6px;
}

.hero-stats span {
  color: var(--muted);
  font-size: 0.86rem;
}

.hero-visual {
  display: none;
}

.visual-card {
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(31, 19, 46, 0.95), rgba(18, 11, 28, 0.94));
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.card-main {
  position: relative;
  width: min(420px, 100%);
  padding: 28px 24px 20px;
}

.card-main::before {
  content: "";
  position: absolute;
  inset: 14px;
  border: 1px solid rgba(216, 180, 254, 0.08);
  border-radius: 22px;
}

.chip {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 0.5rem 0.8rem;
  background: rgba(168, 85, 247, 0.14);
  color: var(--purple-3);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.card-main h2 {
  position: relative;
  z-index: 1;
  margin: 22px 0 20px;
  font-size: clamp(1.7rem, 2vw, 2.5rem);
  line-height: 1.08;
}

.mini-bars {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: end;
  gap: 12px;
  height: 128px;
  margin-top: 18px;
}

.mini-bars span {
  flex: 1 1 0;
  border-radius: 999px 999px 0 0;
  background: linear-gradient(180deg, var(--purple-3), var(--purple-1));
}

.mini-bars span:nth-child(1) { height: 34%; }
.mini-bars span:nth-child(2) { height: 52%; }
.mini-bars span:nth-child(3) { height: 75%; }
.mini-bars span:nth-child(4) { height: 100%; }

.card-floating {
  position: absolute;
  right: 24px;
  bottom: 32px;
  padding: 16px 20px;
  min-width: 180px;
}

.card-floating p {
  margin: 0 0 8px;
  color: var(--muted);
  font-size: 0.8rem;
}

.card-floating strong {
  display: block;
  font-size: 1.3rem;
}

.info-section {
  padding-top: 52px;
}

.section-heading {
  max-width: 760px;
  margin-bottom: 28px;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 3rem);
  line-height: 1.1;
  letter-spacing: -0.05em;
}

.about-grid,
.skills-grid {
  display: grid;
  gap: 22px;
}

.about-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.glass-card,
.skill-card {
  position: relative;
  border: 1px solid var(--line);
  border-radius: 26px;
  background: linear-gradient(180deg, rgba(23, 16, 31, 0.95), rgba(14, 10, 22, 0.92));
  box-shadow: 0 18px 38px rgba(15, 8, 25, 0.3);
  padding: 24px;
}

.glass-card h3,
.skill-card span {
  margin: 0 0 14px;
}

.glass-card p,
.skill-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.skills-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.skill-card span {
  display: inline-block;
  color: var(--purple-3);
  font-weight: 700;
}

.project-carousel {
  position: relative;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 52px;
  align-items: center;
  gap: 16px;
  margin-top: 18px;
}

.carousel-track {
  position: relative;
  min-height: 440px;
  overflow: hidden;
}

.project-slide {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 24px;
  padding: 30px 28px;
  border: 1px solid var(--line);
  border-radius: 30px;
  background: linear-gradient(135deg, rgba(34, 23, 48, 1), rgba(17, 11, 25, 0.96));
  box-shadow: 0 22px 48px rgba(14, 9, 23, 0.4);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateX(36px) scale(0.985);
  transition: opacity 0.6s ease, transform 0.6s ease, visibility 0.6s ease;
}

.project-slide.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(0) scale(1);
}

.project-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.project-tag {
  display: inline-flex;
  width: fit-content;
  padding: 0.52rem 0.82rem;
  border-radius: 999px;
  border: 1px solid rgba(216, 180, 254, 0.2);
  background: rgba(168, 85, 247, 0.08);
  color: var(--purple-3);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.project-copy h3 {
  margin: 18px 0 14px;
  font-size: clamp(1.8rem, 2.4vw, 2.8rem);
  letter-spacing: -0.05em;
}

.project-copy p {
  margin: 0;
  color: var(--muted);
  font-size: 1.02rem;
  line-height: 1.7;
}

.project-copy ul {
  margin: 18px 0 0;
  padding-left: 18px;
  color: var(--text);
  line-height: 1.9;
}

.project-copy li {
  color: var(--muted);
}

.project-copy a {
  display: inline-flex;
  width: fit-content;
  margin-top: 22px;
  color: var(--purple-3);
  font-weight: 700;
}

.project-visual {
  position: relative;
  min-height: 280px;
  border-radius: 24px;
  border: 1px solid rgba(216, 180, 254, 0.09);
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(134, 89, 204, 0.12));
  overflow: hidden;
}

.visual-escada::before,
.visual-escada::after,
.visual-arma::before,
.visual-bim::before {
  content: "";
  position: absolute;
  inset: 0;
}

.visual-escada::before {
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.16), transparent 55%);
}

.visual-panel {
  position: absolute;
  border-radius: 16px;
  border: 1px solid rgba(216, 180, 254, 0.18);
  background: rgba(255, 255, 255, 0.03);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.02);
  animation: floatUp 5.5s ease-in-out infinite;
}

.panel-one { left: 18%; top: 55%; width: 62%; height: 18%; }
.panel-two { left: 26%; top: 38%; width: 48%; height: 16%; animation-delay: 0.3s; }
.panel-three { left: 34%; top: 22%; width: 34%; height: 14%; animation-delay: 0.6s; }
.panel-four { left: 42%; top: 8%; width: 20%; height: 12%; animation-delay: 0.9s; }

.visual-arma::before {
  background: linear-gradient(180deg, rgba(111, 73, 190, 0.22), transparent 55%);
}

.line {
  position: absolute;
  height: 4px;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, var(--purple-3), transparent);
}

.line-a { width: 70%; left: 18%; top: 28%; }
.line-b { width: 58%; left: 24%; top: 48%; }
.line-c { width: 48%; left: 30%; top: 68%; }

.node {
  position: absolute;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--purple-3);
  box-shadow: 0 0 0 8px rgba(216, 180, 254, 0.12), 0 0 20px rgba(168, 85, 247, 0.5);
  animation: pulse 2.4s ease-in-out infinite;
}

.node-a { left: 20%; top: 24%; }
.node-b { left: 48%; top: 44%; animation-delay: 0.4s; }
.node-c { left: 60%; top: 64%; animation-delay: 0.8s; }

.visual-bim::before {
  background: radial-gradient(circle at center, rgba(168, 85, 247, 0.18), transparent 55%);
}

.bim-card {
  position: absolute;
  border: 1px solid rgba(216, 180, 254, 0.18);
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(139, 92, 246, 0.08));
  box-shadow: 0 18px 32px rgba(12, 7, 17, 0.34);
}

.bim-card.card-main { left: 18%; top: 18%; width: 44%; height: 48%; }
.bim-card.card-secondary { right: 16%; top: 24%; width: 34%; height: 36%; }
.bim-card.card-tertiary { left: 30%; bottom: 12%; width: 40%; height: 26%; }

.carousel-btn {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
  font-size: 2rem;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.carousel-btn:hover,
.carousel-btn:focus-visible {
  transform: translateY(-2px);
  border-color: rgba(216, 180, 254, 0.3);
  box-shadow: 0 0 0 6px rgba(168, 85, 247, 0.08);
}

.carousel-dots {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-top: 18px;
}

.dot {
  width: 12px;
  height: 12px;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  cursor: pointer;
  transition: transform 0.2s ease, background 0.2s ease;
}

.dot.is-active {
  background: linear-gradient(135deg, var(--purple-3), var(--purple-1));
  transform: scale(1.2);
}

.contact-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 54px;
  padding: 28px 28px;
  border: 1px solid var(--line);
  border-radius: 28px;
  background: linear-gradient(135deg, rgba(142, 90, 255, 0.16), rgba(18, 10, 26, 0.96));
}

.contact-box h2 {
  margin: 0;
  font-size: clamp(1.8rem, 2.5vw, 2.6rem);
  letter-spacing: -0.04em;
}

.site-footer {
  padding: 28px 0 10px;
  text-align: center;
  color: var(--muted);
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.15); opacity: 0.8; }
}

@keyframes floatUp {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-12px); }
}

@media (max-width: 900px) {
  .hero,
  .about-grid,
  .skills-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    padding-top: 34px;
  }

  .nav {
    display: none;
  }

  .topbar {
    border-radius: 24px;
    padding: 14px 18px;
  }

  .project-slide {
    grid-template-columns: 1fr;
    padding: 22px 18px;
  }

  .project-carousel {
    grid-template-columns: 1fr;
  }

  .carousel-btn {
    display: none;
  }

  .contact-box {
    display: grid;
  }
}

@media (max-width: 620px) {
  .page-shell {
    width: min(100% - 20px, 1180px);
  }

  .hero-stats {
    grid-template-columns: 1fr;
  }

  .cta-group {
    flex-direction: column;
    align-items: stretch;
  }

  .btn {
    width: 100%;
  }

  .card-floating {
    position: static;
    margin-top: 18px;
    width: 100%;
  }

  .hero-visual {
    min-height: auto;
  }

  .carousel-track {
    min-height: 500px;
  }
}



