/* ==========================================================================
   PORTFÓLIO SAMUEL - ENGENHARIA ESTRUTURAL & AUTOMAÇÃO DE SOFTWARE
   Design System: Architectural Slate & Precision Blue
   ========================================================================== */

:root {
  /* Slate & Dark Foundation (Cores orgânicas sem preto puro) */
  --bg: #090d16;
  --bg-subtle: #0f172a;
  --bg-card: rgba(15, 23, 42, 0.82);
  --bg-card-hover: rgba(22, 33, 58, 0.92);
  --bg-elevated: #1e293b;

  /* Blue Palette (Azul de Precisão Técnica & Engenharia) */
  --blue-primary: #2563eb;
  --blue-primary-hover: #1d4ed8;
  --blue-accent: #38bdf8;
  --blue-light: #60a5fa;
  --blue-soft: rgba(37, 99, 235, 0.12);
  --blue-border: rgba(59, 130, 246, 0.28);
  --blue-glow: rgba(37, 99, 235, 0.2);

  /* Tipografia & Contrastes Neutros */
  --text-main: #f1f5f9;
  --text-muted: #94a3b8;
  --text-dim: #64748b;

  /* Linhas e Elevações Tênues */
  --border-subtle: rgba(148, 163, 184, 0.12);
  --border-medium: rgba(148, 163, 184, 0.22);
  --shadow-sm: 0 2px 8px -1px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 12px 32px -4px rgba(2, 6, 23, 0.45), 0 0 0 1px var(--border-subtle);
  --shadow-hover: 0 18px 40px -6px rgba(2, 6, 23, 0.6), 0 0 0 1px var(--blue-border);

  /* Curvaturas Intencionais */
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --radius-pill: 9999px;

  /* Transições Suaves */
  --transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background-color: var(--bg);
  background-image: 
    /* Grid sutil de engenharia/blueprint */
    linear-gradient(to right, rgba(59, 130, 246, 0.035) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(59, 130, 246, 0.035) 1px, transparent 1px),
    /* Iluminação difusa arquitetônica azul */
    radial-gradient(ellipse 70% 50% at 50% -10%, rgba(37, 99, 235, 0.16), transparent 70%),
    radial-gradient(circle at 90% 85%, rgba(14, 165, 233, 0.08), transparent 50%);
  background-size: 40px 40px, 40px 40px, 100% 100%, 100% 100%;
  color: var(--text-main);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

a {
  color: inherit;
  text-decoration: none;
  transition: var(--transition);
}

button {
  font: inherit;
  border: none;
  background: none;
  cursor: pointer;
}

/* ==========================================================================
   LAYOUT SHELL
   ========================================================================== */

.page-shell {
  width: min(1160px, calc(100% - 40px));
  margin: 0 auto;
  padding: 24px 0 60px;
}

/* ==========================================================================
   TOPBAR & NAVEGAÇÃO
   ========================================================================== */

.topbar {
  position: sticky;
  top: 16px;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 12px 24px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-pill);
  background: rgba(11, 17, 30, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  transition: var(--transition);
}

.topbar:hover {
  border-color: var(--border-medium);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-weight: 600;
  font-size: 0.98rem;
  letter-spacing: -0.01em;
  color: var(--text-main);
}

.brand-mark {
  display: inline-grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: linear-gradient(135deg, var(--blue-primary), var(--blue-accent));
  color: #ffffff;
  font-weight: 800;
  font-size: 0.95rem;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-text span:first-child {
  font-weight: 600;
  line-height: 1.2;
}

.brand-tag {
  font-size: 0.72rem;
  color: var(--text-muted);
  font-weight: 400;
}

.nav {
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav a {
  font-size: 0.92rem;
  color: var(--text-muted);
  font-weight: 500;
  padding: 6px 4px;
  position: relative;
}

.nav a:hover,
.nav a:focus-visible {
  color: var(--text-main);
}

.nav a::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 2px;
  background: var(--blue-accent);
  border-radius: 99px;
  transition: width 0.2s ease;
}

.nav a:hover::after {
  width: 100%;
}

/* ==========================================================================
   BOTÕES E MICROINTERAÇÕES TÁTEIS
   ========================================================================== */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0.65rem 1.35rem;
  border-radius: var(--radius-pill);
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  white-space: nowrap;
  transition: var(--transition);
  outline: none;
}

.btn:focus-visible {
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.45);
}

.btn-primary {
  background: var(--blue-primary);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
}

.btn-primary:hover {
  background: var(--blue-primary-hover);
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(37, 99, 235, 0.45);
}

.btn-primary:active {
  transform: translateY(0);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-main);
  border: 1px solid var(--border-subtle);
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--border-medium);
  transform: translateY(-2px);
}

.btn-secondary:active {
  transform: translateY(0);
}

/* ==========================================================================
   HERO SECTION
   ========================================================================== */

.hero {
  padding: 72px 0 48px;
  text-align: center;
}

.hero-copy {
  max-width: 860px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: var(--radius-pill);
  background: rgba(37, 99, 235, 0.08);
  border: 1px solid rgba(59, 130, 246, 0.22);
  color: var(--blue-accent);
  font-size: 0.8rem;
  font-weight: 500;
  margin-bottom: 24px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  animation: pulse-ring 2.5s infinite;
}

@keyframes pulse-ring {
  0% { box-shadow: 0 0 0 0px rgba(16, 185, 129, 0.4); }
  70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
  100% { box-shadow: 0 0 0 0px rgba(16, 185, 129, 0); }
}

.hero-copy h1 {
  font-size: clamp(2.4rem, 4.4vw, 3.8rem);
  font-weight: 700;
  line-height: 1.14;
  letter-spacing: -0.025em;
  color: var(--text-main);
  margin-bottom: 20px;
}

.gradient-text {
  background: linear-gradient(135deg, #60a5fa 10%, #38bdf8 80%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.lead {
  max-width: 68ch;
  color: var(--text-muted);
  font-size: 1.06rem;
  line-height: 1.7;
  font-weight: 400;
  margin-bottom: 32px;
}

.cta-group {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 48px;
}

/* Pilares Técnicos no Hero */
.hero-stats {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  width: 100%;
  max-width: 980px;
  margin: 0 auto;
}

.stat-item {
  padding: 18px 16px;
  border-radius: var(--radius-md);
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  text-align: left;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.stat-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--blue-primary), transparent);
  opacity: 0;
  transition: var(--transition);
}

.stat-item:hover {
  transform: translateY(-2px);
  border-color: var(--blue-border);
  background: var(--bg-card-hover);
  box-shadow: var(--shadow-sm);
}

.stat-item:hover::before {
  opacity: 1;
}

.stat-item strong {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6px;
  letter-spacing: -0.01em;
}

.stat-item strong svg {
  color: var(--blue-accent);
  flex-shrink: 0;
}

.stat-item span {
  display: block;
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.45;
}

/* ==========================================================================
   SEÇÕES GERAIS & CABEÇALHOS
   ========================================================================== */

.info-section {
  padding: 64px 0 20px;
}

.section-heading {
  max-width: 760px;
  margin-bottom: 36px;
}

.eyebrow {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--blue-accent);
  margin-bottom: 10px;
}

.section-heading h2 {
  font-size: clamp(1.8rem, 2.6vw, 2.3rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.25;
  color: var(--text-main);
}

/* ==========================================================================
   CARDS DE "SOBRE"
   ========================================================================== */

.about-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.about-card {
  padding: 28px 24px;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
  transition: var(--transition);
  display: flex;
  flex-direction: column;
}

.about-card:hover {
  transform: translateY(-3px);
  border-color: var(--blue-border);
  box-shadow: var(--shadow-md);
  background: var(--bg-card-hover);
}

.card-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: var(--blue-soft);
  border: 1px solid var(--blue-border);
  display: grid;
  place-items: center;
  color: var(--blue-accent);
  margin-bottom: 20px;
  transition: var(--transition);
}

.about-card:hover .card-icon {
  transform: scale(1.05);
  background: rgba(37, 99, 235, 0.2);
}

.about-card h3 {
  font-size: 1.15rem;
  font-weight: 600;
  letter-spacing: -0.015em;
  margin-bottom: 12px;
  color: var(--text-main);
}

.about-card p {
  color: var(--text-muted);
  font-size: 0.94rem;
  line-height: 1.65;
}

/* ==========================================================================
   CARDS DE "COMPETÊNCIAS"
   ========================================================================== */

.skills-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.skill-card {
  padding: 24px;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  transition: var(--transition);
  display: flex;
  flex-direction: column;
}

.skill-card:hover {
  transform: translateY(-3px);
  border-color: var(--blue-border);
  box-shadow: var(--shadow-md);
  background: var(--bg-card-hover);
}

.skill-tag {
  display: inline-block;
  align-self: flex-start;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--blue-light);
  background: var(--blue-soft);
  border: 1px solid rgba(59, 130, 246, 0.2);
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  margin-bottom: 14px;
}

.skill-card h3 {
  font-size: 1.05rem;
  font-weight: 600;
  margin-bottom: 10px;
  color: var(--text-main);
}

.skill-card p {
  color: var(--text-muted);
  font-size: 0.88rem;
  line-height: 1.6;
}

/* ==========================================================================
   CARROSSEL DE PROJETOS & VISUAIS TÉCNICOS
   ========================================================================== */

.project-carousel {
  position: relative;
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr) 46px;
  align-items: center;
  gap: 16px;
}

.carousel-track {
  position: relative;
  min-height: 480px;
}

.project-slide {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 28px;
  padding: 36px 32px;
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-md);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateX(20px) scale(0.99);
  transition: opacity 0.4s ease, transform 0.4s ease, visibility 0.4s ease;
}

.project-slide.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(0) scale(1);
}

.project-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.project-badges {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.badge {
  font-size: 0.72rem;
  font-weight: 600;
  padding: 3px 10px;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-muted);
}

.badge.primary {
  background: var(--blue-soft);
  border-color: var(--blue-border);
  color: var(--blue-accent);
}

.project-copy h3 {
  font-size: clamp(1.4rem, 2vw, 1.8rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.25;
  color: var(--text-main);
  margin-bottom: 14px;
}

.project-copy p {
  color: var(--text-muted);
  font-size: 0.94rem;
  line-height: 1.65;
  margin-bottom: 18px;
}

.project-features {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 24px;
}

.project-features li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.86rem;
  color: var(--text-muted);
}

.project-features li svg {
  color: var(--blue-accent);
  flex-shrink: 0;
  margin-top: 3px;
}

.project-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--blue-light);
  width: fit-content;
}

.project-link:hover {
  color: var(--blue-accent);
  gap: 10px;
}

/* ==========================================================================
   MOCKUPS VISUAIS AUTÊNTICOS
   ========================================================================== */

.project-visual-container {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #080c14;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 16px;
  overflow: hidden;
  position: relative;
}

/* Mockup 1: Terminal de Código Python TQS */
.terminal-window {
  width: 100%;
  background: #0b111e;
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.terminal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  background: #111a2e;
  border-bottom: 1px solid var(--border-subtle);
}

.terminal-dots {
  display: flex;
  gap: 6px;
}

.terminal-dots span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #334155;
}

.terminal-dots span:nth-child(1) { background: #ef4444; }
.terminal-dots span:nth-child(2) { background: #f59e0b; }
.terminal-dots span:nth-child(3) { background: #10b981; }

.terminal-title {
  font-family: ui-monospace, Menlo, Consolas, monospace;
  font-size: 0.76rem;
  color: var(--text-dim);
}

.terminal-status {
  font-size: 0.7rem;
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
  padding: 2px 6px;
  border-radius: 4px;
}

.terminal-body {
  padding: 14px 16px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.8rem;
  line-height: 1.6;
  color: #cbd5e1;
}

.code-keyword { color: #60a5fa; }
.code-fn { color: #38bdf8; }
.code-str { color: #34d399; }
.code-param { color: #f472b6; }
.code-comment { color: #64748b; font-style: italic; }

.terminal-output {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px dashed var(--border-subtle);
  color: #10b981;
  font-size: 0.74rem;
}

/* Mockup 2: Inspeção de Armadura BIM Revit */
.bim-inspector {
  width: 100%;
  background: #0b111e;
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-md);
  padding: 16px;
}

.inspector-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border-subtle);
}

.inspector-title {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 6px;
}

.inspector-badge {
  font-size: 0.72rem;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(37, 99, 235, 0.15);
  color: var(--blue-accent);
  border: 1px solid rgba(59, 130, 246, 0.25);
}

.rebar-params {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 14px;
}

.param-box {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border-subtle);
  padding: 8px 10px;
  border-radius: 6px;
}

.param-box label {
  display: block;
  font-size: 0.7rem;
  color: var(--text-dim);
  margin-bottom: 2px;
}

.param-box span {
  display: block;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-main);
}

.cad-cross-section {
  position: relative;
  height: 110px;
  background: #070b12;
  border: 1px solid rgba(59, 130, 246, 0.2);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-concrete {
  width: 75%;
  height: 70%;
  border: 2px dashed rgba(148, 163, 184, 0.4);
  position: relative;
  display: flex;
  justify-content: space-between;
  padding: 6px;
}

.rebar-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--blue-accent);
  box-shadow: 0 0 6px var(--blue-accent);
}

.inspector-footer {
  margin-top: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.72rem;
  color: var(--text-dim);
}

.status-ok {
  color: #10b981;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* Mockup 3: Pipeline Interoperável TQS ↔ Revit */
.pipeline-inspector {
  width: 100%;
  background: #0b111e;
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-md);
  padding: 18px 14px;
}

.pipeline-nodes {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pipeline-node {
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid var(--border-subtle);
  padding: 10px 12px;
  border-radius: 8px;
  transition: var(--transition);
}

.pipeline-node.active-node {
  border-color: var(--blue-border);
  background: rgba(37, 99, 235, 0.08);
}

.node-icon {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: var(--blue-soft);
  color: var(--blue-accent);
  display: grid;
  place-items: center;
  font-size: 0.75rem;
  font-weight: 700;
}

.node-info {
  flex: 1;
}

.node-info h4 {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-main);
}

.node-info p {
  font-size: 0.72rem;
  color: var(--text-dim);
}

.node-status {
  font-size: 0.7rem;
  color: #10b981;
  font-family: ui-monospace, Menlo, monospace;
}

/* ==========================================================================
   CONTROLES DO CARROSSEL
   ========================================================================== */

.carousel-btn {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: 1px solid var(--border-subtle);
  border-radius: 50%;
  background: var(--bg-card);
  color: var(--text-main);
  transition: var(--transition);
  outline: none;
}

.carousel-btn:hover {
  background: var(--bg-card-hover);
  border-color: var(--blue-border);
  color: var(--blue-accent);
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

.carousel-btn:focus-visible {
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.4);
}

.carousel-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 24px;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: var(--radius-pill);
  background: rgba(148, 163, 184, 0.25);
  transition: var(--transition);
  outline: none;
}

.dot:hover {
  background: rgba(148, 163, 184, 0.5);
}

.dot.is-active {
  width: 24px;
  background: var(--blue-primary);
}

/* ==========================================================================
   SEÇÃO DE CONTATO
   ========================================================================== */

.contact-box {
  margin-top: 64px;
  padding: 44px 40px;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, rgba(23, 37, 84, 0.45), rgba(15, 23, 42, 0.85));
  border: 1px solid var(--blue-border);
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}

.contact-content {
  max-width: 620px;
}

.contact-content h2 {
  font-size: clamp(1.6rem, 2.4vw, 2.2rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-main);
  margin-bottom: 12px;
  line-height: 1.25;
}

.contact-content p {
  color: var(--text-muted);
  font-size: 0.98rem;
  line-height: 1.6;
}

.contact-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 220px;
}

.copy-feedback {
  font-size: 0.78rem;
  color: #10b981;
  text-align: center;
  opacity: 0;
  transition: opacity 0.2s ease;
  height: 16px;
}

.copy-feedback.show {
  opacity: 1;
}

/* ==========================================================================
   FOOTER
   ========================================================================== */

.site-footer {
  padding: 48px 0 16px;
  text-align: center;
  color: var(--text-dim);
  font-size: 0.85rem;
  border-top: 1px solid var(--border-subtle);
  margin-top: 60px;
}

/* ==========================================================================
   RESPONSIVIDADE INTELIGENTE
   ========================================================================== */

@media (max-width: 980px) {
  .hero-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .skills-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .project-slide {
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 28px 22px;
  }

  .carousel-track {
    min-height: 600px;
  }

  .contact-box {
    flex-direction: column;
    align-items: flex-start;
    padding: 32px 24px;
  }

  .contact-actions {
    width: 100%;
  }
}

@media (max-width: 680px) {
  .page-shell {
    width: calc(100% - 24px);
  }

  .nav {
    display: none;
  }

  .topbar {
    padding: 10px 16px;
  }

  .hero {
    padding: 40px 0 30px;
  }

  .hero-stats {
    grid-template-columns: 1fr;
  }

  .skills-grid {
    grid-template-columns: 1fr;
  }

  .cta-group {
    flex-direction: column;
    width: 100%;
  }

  .cta-group .btn {
    width: 100%;
  }

  .carousel-btn {
    display: none;
  }

  .project-carousel {
    grid-template-columns: 1fr;
  }

  .carousel-track {
    min-height: 640px;
  }
}
